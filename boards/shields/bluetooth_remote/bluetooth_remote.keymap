#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    combos {
        compatible = "zmk,combos";

        combo_bt_clear {
            timeout-ms = <150>;
            key-positions = <0 1 2>;
            bindings = <&bt BT_CLR>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp C_PP   &kp C_PREV   &kp C_NEXT   &kp C_VOL_UP   &kp C_VOL_DN   &kp KP_PLUS   &kp KP_MINUS
            >;
        };
    };
};