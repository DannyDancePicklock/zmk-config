#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp C_PP   &kp C_PREV   &kp C_NEXT   &kp C_VOL_UP   &kp C_VOL_DN   &kp KP_PLUS   &kp KP_MINUS
            >;
        };
    };
};