#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    behaviors {
        /* Kopplungsmodus starten (loescht den alten PC) */
        pairing_start: pairing_start {
            compatible = "zmk,behavior-bt-remote-pairing";
            #binding-cells = <0>;
        };

        /* Erst nach 2 s Halten ausloesen, kurz gedrueckt passiert nichts */
        pair_hold: pair_hold {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <2000>;
            bindings = <&pairing_start>, <&none>;
        };
    };

    combos {
        compatible = "zmk,combos";

        /* Kopplungsmodus: Play + Lauter zusammen 2 s halten.
         * Abbrechen: Play kurz druecken. */
        combo_bt_clear {
            timeout-ms = <150>;
            key-positions = <0 3>;
            bindings = <&pair_hold 0 0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp C_PP   &kp C_PREV   &kp C_NEXT   &kp C_VOL_UP   &kp C_VOL_DN
            >;

            sensor-bindings = <&inc_dec_kp KP_MINUS KP_PLUS>;
        };
    };
};