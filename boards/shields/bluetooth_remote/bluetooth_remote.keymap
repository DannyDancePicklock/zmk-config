#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/reset.h>

/ {
    behaviors {
        /* Kopplung loeschen erst nach 2 s Halten.
         * Kurz gedrueckt passiert nichts (tap = &none). */
        bt_clr_hold: bt_clr_hold {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <2000>;
            bindings = <&bt>, <&none>;
        };

        /* Kompletter Neustart der Kopplung: alle gespeicherten PCs
         * loeschen, kurz warten, dann neu booten. */
        pairing_reset: pairing_reset {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &bt BT_CLR_ALL>
                , <&macro_wait_time 300>
                , <&macro_tap &sys_reset>
                ;
        };

        /* Play: kurz = Play/Pause (wird beim Loslassen gesendet),
         * 2 s halten = Kopplung zuruecksetzen */
        play_reset: play_reset {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <2000>;
            bindings = <&pairing_reset>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        /* Kopplungsmodus: Play + Lauter zusammen 2 s halten */
        combo_bt_clear {
            timeout-ms = <150>;
            key-positions = <0 3>;
            bindings = <&bt_clr_hold BT_CLR 0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &play_reset 0 C_PP   &kp C_PREV   &kp C_NEXT   &kp C_VOL_UP   &kp C_VOL_DN
            >;

            sensor-bindings = <&inc_dec_kp KP_MINUS KP_PLUS>;
        };
    };
};